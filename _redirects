# Cloudflare Workers static assets — _redirects. Rules run BEFORE asset serving.
# Max 2100 rules; first match wins. Apache .htaccess is NOT used on this host.

# --- PRESERVED (was already here) --------------------------------------------
# Clean URLs. Workers static assets already serves /services from services.html
# and 307s the .html form; these rules make that a permanent 301 instead, so
# any link or index entry pointing at the old .html URL consolidates properly.
/index.html         /               301
/services.html      /services       301
/service-areas.html /service-areas  301
/contact-us.html    /contact-us     301

# --- PRESERVED (was already here) --------------------------------------------
# Source paths are not part of the public site. Redirects run before assets, so
# these can never be fetched even if a file ends up in the upload.
# (.assetsignore keeps them out of it as well.)
/pages/*            /  301
/templates/*        /  301
/marketingskills/*  /  301
/site.json          /  301
/build.js           /  301
/package.json       /  301
/wrangler.jsonc     /  301

# --- NEW ---------------------------------------------------------------------
# /index.htm was a 404. Send it to the canonical homepage like /index.html.
/index.htm          /               301

# Trailing-slash variants. Workers static assets answers these with a 307;
# these make it a permanent 301 so link equity consolidates on the no-slash form.
# The root "/" is left alone — it is the canonical homepage URL.
/services/          /services       301
/service-areas/     /service-areas  301
/contact-us/        /contact-us     301
/thank-you/         /thank-you      301

# The generated 404 document is noindex; keep a single address for it.
/404.html           /404            301

# The thank-you page has one canonical address.
/thank-you.html     /thank-you      301

# Legal pages — one canonical address each.
/privacy-policy/            /privacy-policy             301
/privacy-policy.html        /privacy-policy             301
/terms-and-conditions/      /terms-and-conditions       301
/terms-and-conditions.html  /terms-and-conditions       301
/terms-of-sale/             /terms-of-sale              301
/terms-of-sale.html         /terms-of-sale              301
/returns-and-refunds-policy/ /returns-and-refunds-policy 301
/returns-and-refunds-policy.html /returns-and-refunds-policy 301
/shipping-policy/           /shipping-policy            301
/shipping-policy.html       /shipping-policy            301

# Support, compliance and information pages - one canonical address each.
/faqs/                             /faqs                              301
/faqs.html                         /faqs                              301
/help-and-support/                 /help-and-support                  301
/help-and-support.html             /help-and-support                  301
/customer-services/                /customer-services                 301
/customer-services.html            /customer-services                 301
/applications-and-approvals/       /applications-and-approvals        301
/applications-and-approvals.html   /applications-and-approvals        301
/complaints-and-feedback/          /complaints-and-feedback           301
/complaints-and-feedback.html      /complaints-and-feedback           301
/careers/                          /careers                           301
/careers.html                      /careers                           301
/acknowledgement-of-country/       /acknowledgement-of-country        301
/acknowledgement-of-country.html   /acknowledgement-of-country        301
/website-disclaimer/               /website-disclaimer                301
