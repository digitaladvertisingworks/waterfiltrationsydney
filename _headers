# Cloudflare Workers static assets — _headers.
# NOTE: Cloudflare also strips/overrides some security headers at the zone level;
# verify with `curl -I` after deploy.

/*
  # --- PRESERVED (was already here) ---
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  # --- NEW ---
  # HSTS: 1 year, no includeSubDomains (www is not yet serving HTTPS content
  # correctly — see the report) and no preload without sign-off.
  Strict-Transport-Security: max-age=31536000
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
  X-XSS-Protection: 0
  Cross-Origin-Opener-Policy: same-origin
  # CSP tuned to what this site actually loads:
  #   'unsafe-inline' on script-src   -> the four application/ld+json blocks
  #   'unsafe-inline' on style-src    -> inline style="" attributes in the HTML
  #   api.web3forms.com               -> the quote form (fetch + no-JS fallback)
  # There is no analytics, GTM, reCAPTCHA, maps, chat or video embed on the site.
  # If any of those are added later, widen script-src/connect-src/frame-src here.
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; media-src 'self'; connect-src 'self' https://api.web3forms.com; form-action 'self' https://api.web3forms.com; frame-ancestors 'self'; upgrade-insecure-requests

# --- PRESERVED (was already here) ---
/images/*
  Cache-Control: public, max-age=31536000, immutable

/img/*
  Cache-Control: public, max-age=31536000, immutable

/css/*
  Cache-Control: public, max-age=604800

/js/*
  Cache-Control: public, max-age=604800

# --- NEW ---
# Crawler-facing files: short cache so edits go live quickly.
/robots.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600

/sitemap.xml
  Content-Type: application/xml; charset=utf-8
  Cache-Control: public, max-age=3600

# The entity fragment carries no <head>, so noindex is sent as a header instead
# of a meta tag. It is a data fragment, not a page that should rank.
/business-info
  X-Robots-Tag: noindex, follow
  Content-Type: text/html; charset=utf-8
